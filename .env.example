# Copie para .env e preencha. No Render estas viram env vars do Cron Job.

# --- Obrigatórias -------------------------------------------------------------
# Roteiro (gpt-5.6-luna) e as 8 fotos (gpt-image-2).
OPENAI_API_KEY=
# Trilha instrumental do Short (POST /v1/music).
ELEVENLABS_API_KEY=

# --- YouTube ------------------------------------------------------------------
# Credenciais OAuth do projeto no Google Cloud. Podem ser as mesmas usadas pelo
# automacao-video: o que separa os canais é o refresh token, não o client.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Preenchido automaticamente por 'python main.py --auth-youtube'.
# Autorize com a conta do canal @GatinhoCriaDaRua.
YOUTUBE_REFRESH_TOKEN=

# --- Opcionais (os valores abaixo já são os padrões) --------------------------
# YOUTUBE_PRIVACY=public          # public | unlisted | private
# YOUTUBE_CATEGORY_ID=15          # 15 = Pets & Animals
# TEXT_MODEL=gpt-5.6-luna
# IMAGEM_MODEL=gpt-image-2
# IMAGEM_QUALIDADE=high           # low | medium | high | auto
# ELEVENLABS_MUSIC_MODEL=music_v1
# VIDEO_LARGURA=1080
# VIDEO_ALTURA=1920
# VIDEO_FPS=30
